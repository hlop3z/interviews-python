---
interface Props {
  label?: string;
  compact?: boolean;
}

const { label = 'Senior insight', compact = false } = Astro.props;
---

<div
  class:list={[
    'border-l-4 border-indigo-500 bg-indigo-50 dark:bg-indigo-900/20 rounded-r-md',
    compact ? 'px-3 py-2 my-2 text-sm' : 'p-4 my-3',
  ]}
>
  <p class="font-semibold text-indigo-700 dark:text-indigo-300 mb-1 uppercase tracking-wide text-xs">
    {label}
  </p>
  <div class="text-gray-700 dark:text-gray-300 leading-relaxed">
    <slot />
  </div>
</div>
