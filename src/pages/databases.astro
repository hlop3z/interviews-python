---
import DocsLayout from '@/layouts/DocsLayout.astro';
import SimpleTable from '@/components/tables/SimpleTable.astro';
import SeniorInsight from '@/components/ui/SeniorInsight.astro';
import NoteBox from '@/components/ui/NoteBox.astro';
import TradeoffTable from '@/components/ui/TradeoffTable.astro';
import {
  sqlVsNoSql,
  isolationLevels,
  replicationModes,
  shardingStrategies,
  indexTypes,
  indexingRules,
} from '@/data/databases';

const isolationCols = [
  { key: 'level', label: 'Level', class: 'font-semibold' },
  { key: 'prevents', label: 'Prevents' },
  { key: 'stillAllows', label: 'Still allows' },
  { key: 'typicalUse', label: 'Typical use' },
];

const replicationCols = [
  { key: 'mode', label: 'Mode', class: 'font-semibold' },
  { key: 'howItWorks', label: 'How it works' },
  { key: 'consistency', label: 'Consistency' },
  { key: 'tradeoff', label: 'Trade-off' },
];

const shardingCols = [
  { key: 'name', label: 'Strategy', class: 'font-semibold' },
  { key: 'howItWorks', label: 'How it works' },
  { key: 'pros', label: 'Pros' },
  { key: 'cons', label: 'Cons' },
];

const indexCols = [
  { key: 'type', label: 'Type', class: 'font-semibold' },
  { key: 'bestFor', label: 'Best for' },
  { key: 'avoidFor', label: 'Avoid for' },
  { key: 'note', label: 'Note' },
];
---

<DocsLayout title="Databases" wide>
  <h1 class="text-3xl font-bold mb-2">Databases</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-6">
    The four decisions interviewers push on: relational vs not, isolation level,
    replication mode, and sharding strategy. Plus a reminder on indexing.
  </p>

  <SeniorInsight label="The senior framing">
    "Which database" is the wrong first question. The right questions are: what
    is the access pattern, what consistency do I need, what is the read/write
    mix, and what is the failure mode I cannot tolerate? The database falls out
    of the answers.
  </SeniorInsight>

  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">SQL vs NoSQL</h2>
    <TradeoffTable tradeoff={sqlVsNoSql} />
  </section>

  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">Isolation levels</h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
      Ordered weakest → strongest. Know what each level <em>allows</em>, not
      just what it <em>prevents</em> — that is where bugs live.
    </p>
    <SimpleTable data={isolationLevels} columns={isolationCols} />
  </section>

  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">Replication modes</h2>
    <SimpleTable data={replicationModes} columns={replicationCols} />
  </section>

  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">Sharding strategies</h2>
    <SimpleTable data={shardingStrategies} columns={shardingCols} />
  </section>

  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">Index types</h2>
    <SimpleTable data={indexTypes} columns={indexCols} />
    <NoteBox title="Indexing rules" variant="tip">
      <ul class="list-disc list-outside ml-5 space-y-1">
        {indexingRules.map((r) => <li>{r}</li>)}
      </ul>
    </NoteBox>
  </section>
</DocsLayout>
