---
import DocsLayout from '@/layouts/DocsLayout.astro';
import SeniorInsight from '@/components/ui/SeniorInsight.astro';
import NoteBox from '@/components/ui/NoteBox.astro';
import {
  prompts,
  starTemplate,
  answerShapeRules,
  questionsToAsk,
} from '@/data/behavioral-notes';
---

<DocsLayout title="Behavioral" wide>
  <h1 class="text-3xl font-bold mb-2">Behavioral</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-6">
    The recurring prompts, each with <strong>junior / mid / senior</strong>
    answer shapes. Calibrate yourself: are you answering at the level you are
    interviewing for?
  </p>

  <SeniorInsight label="The core signal">
    Behavioral is not "soft" — it is where the loop asks "can we trust you with
    ambiguity, failure, and other people?" Juniors describe what happened.
    Seniors describe what they learned about themselves.
  </SeniorInsight>

  <!-- STAR template -->
  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">STAR template</h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">{starTemplate.headline}</p>
    <div class="grid md:grid-cols-4 gap-3 mb-4">
      {starTemplate.steps.map((s) => (
        <div class="border border-gray-200 dark:border-gray-700 rounded p-3">
          <p class="font-mono font-bold text-2xl text-indigo-600 dark:text-indigo-400">{s.letter}</p>
          <p class="font-semibold mt-1">{s.name}</p>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{s.guide}</p>
        </div>
      ))}
    </div>
    <NoteBox title="The mistake everyone makes" variant="warning">
      {starTemplate.common_mistake}
    </NoteBox>
  </section>

  <!-- Answer shape rules -->
  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">Answer-shape rules</h2>
    <ul class="space-y-2">
      {answerShapeRules.map((r) => (
        <li class="border-l-4 border-indigo-500 pl-4 py-2 text-sm">{r}</li>
      ))}
    </ul>
  </section>

  <!-- Table of contents -->
  <nav class="my-8 p-4 rounded-lg bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
    <p class="font-semibold mb-2">Prompts</p>
    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1 text-sm">
      {prompts.map((p) => (
        <li>
          <a href={`#${p.id}`} class="text-indigo-600 dark:text-indigo-400 hover:underline">
            {p.prompt}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- The prompts -->
  {prompts.map((p) => (
    <article
      id={p.id}
      class="border border-gray-200 dark:border-gray-700 rounded-lg p-5 mb-6 scroll-mt-20"
    >
      <header class="mb-3">
        <h2 class="text-xl font-bold">{p.prompt}</h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 italic mt-1">
          What they probe: {p.whatTheyProbe}
        </p>
      </header>

      <div class="grid md:grid-cols-3 gap-3 text-sm mb-3">
        <div class="border border-gray-200 dark:border-gray-700 rounded p-3">
          <p class="font-semibold text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">Junior shape</p>
          <p class="text-gray-700 dark:text-gray-300">{p.junior}</p>
        </div>
        <div class="border border-gray-200 dark:border-gray-700 rounded p-3">
          <p class="font-semibold text-xs uppercase tracking-wide text-blue-600 dark:text-blue-400 mb-2">Mid shape</p>
          <p class="text-gray-700 dark:text-gray-300">{p.mid}</p>
        </div>
        <div class="border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-900/20 rounded p-3">
          <p class="font-semibold text-xs uppercase tracking-wide text-indigo-700 dark:text-indigo-300 mb-2">Senior shape</p>
          <p class="text-gray-700 dark:text-gray-300">{p.senior}</p>
        </div>
      </div>

      <div>
        <p class="font-semibold text-xs uppercase tracking-wide text-red-600 dark:text-red-400 mb-2">Red flags</p>
        <ul class="list-disc list-outside ml-5 space-y-1 text-sm text-gray-700 dark:text-gray-300">
          {p.redFlags.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </article>
  ))}

  <!-- Questions to ask back -->
  <section class="my-8">
    <h2 class="text-2xl font-semibold mb-3">Questions to ask them</h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
      Every interview ends with "do you have any questions for us?" A senior
      candidate asks questions that probe how the team actually works, not
      surface trivia.
    </p>
    <ul class="space-y-2">
      {questionsToAsk.map((q) => (
        <li class="border-l-4 border-emerald-500 pl-4 py-2 text-sm italic">{q}</li>
      ))}
    </ul>
  </section>
</DocsLayout>
