---
import DocsLayout from '@/layouts/DocsLayout.astro';
import SimpleTable from '@/components/tables/SimpleTable.astro';
import NoteBox from '@/components/ui/NoteBox.astro';
import SeniorInsight from '@/components/ui/SeniorInsight.astro';
import TradeoffTable from '@/components/ui/TradeoffTable.astro';
import { restMethods, restConstraints, graphqlConcepts } from '@/data/api-notes';
import {
  idempotencyTable,
  idempotencyKeyPattern,
  oauthGrants,
  rateLimitPlacement,
  restVsRpcVsGraphqlTradeoff,
  jwtPitfalls,
  sessionVsToken,
  sessionVsTokenRule,
  paginationModes,
  webhookPractices,
  resilienceKnobs,
  retryRule,
} from '@/data/api-depth';

const jwtCols = [
  { key: 'name', label: 'Pitfall', class: 'font-semibold' },
  { key: 'risk', label: 'Risk' },
  { key: 'mitigation', label: 'Mitigation' },
];

const paginationCols = [
  { key: 'name', label: 'Mode', class: 'font-semibold' },
  { key: 'howItWorks', label: 'How it works' },
  { key: 'bestFor', label: 'Best for' },
  { key: 'failureMode', label: 'Failure mode' },
];

const resilienceCols = [
  { key: 'name', label: 'Knob', class: 'font-semibold' },
  { key: 'purpose', label: 'Purpose' },
  { key: 'typicalValue', label: 'Typical value' },
  { key: 'mistake', label: 'Common mistake' },
];

const methodColumns = [
  { key: 'name', label: 'Method', class: 'font-mono font-medium' },
  { key: 'description', label: 'CRUD Operation' },
];

const conceptColumns = [
  { key: 'name', label: 'Name', class: 'font-medium whitespace-nowrap' },
  { key: 'description', label: 'Description' },
];
---

<DocsLayout title="APIs">
  <h1 class="text-3xl font-bold mb-8">APIs</h1>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">REST Architectural Constraints</h2>
    <SimpleTable data={restConstraints} columns={conceptColumns} />
    <NoteBox title="Note" variant="info">
      <p>REST = <strong>RE</strong>presentational <strong>S</strong>tate <strong>T</strong>ransfer</p>
    </NoteBox>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">REST Methods</h2>
    <div class="max-w-md">
      <SimpleTable data={restMethods} columns={methodColumns} />
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">GraphQL</h2>
    <SimpleTable data={graphqlConcepts} columns={conceptColumns} />
  </section>

  <!-- REST vs GraphQL tradeoff -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">REST vs GraphQL</h2>
    <TradeoffTable tradeoff={restVsRpcVsGraphqlTradeoff} />
  </section>

  <!-- HTTP method semantics -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">Safety & idempotency by method</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      <strong>Safe</strong> = no server-side state change. <strong>Idempotent</strong>
      = same request sent twice has the same effect as once. These two properties
      drive caching, retry logic, and CDN behavior — get them wrong and clients
      silently double-charge, duplicate orders, or leak updates.
    </p>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Method</th>
            <th class="text-center">Safe?</th>
            <th class="text-center">Idempotent?</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          {idempotencyTable.map((r) => (
            <tr>
              <td class="font-mono font-medium">{r.method}</td>
              <td class="text-center text-sm">{r.safe}</td>
              <td class="text-center text-sm">{r.idempotent}</td>
              <td class="text-sm text-gray-600 dark:text-gray-400">{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold mt-6 mb-2">Idempotency keys for POST</h3>
    <p class="text-gray-700 dark:text-gray-300 mb-3">{idempotencyKeyPattern.shape}</p>
    <p class="font-semibold mb-2">Invariants</p>
    <ul class="list-disc list-outside ml-5 space-y-1 text-sm">
      {idempotencyKeyPattern.invariants.map((inv) => <li>{inv}</li>)}
    </ul>
    <SeniorInsight label="Why this matters">
      Every payment, booking, and "send" button on the internet has this
      requirement. Talking through the TTL choice, the payload-hash check, and
      the cached status-code is what separates the senior answer from the
      textbook one.
    </SeniorInsight>
  </section>

  <!-- OAuth2 grants -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">OAuth 2.0 grant types</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Pick the grant that fits the client. OAuth 2.1 consolidates on PKCE-backed
      flows and retires the legacy ones.
    </p>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Grant</th>
            <th>Use case</th>
            <th>Flow</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {oauthGrants.map((g) => (
            <tr>
              <td class="font-medium">{g.name}</td>
              <td class="text-sm">{g.useCase}</td>
              <td class="text-sm text-gray-600 dark:text-gray-400">{g.flow}</td>
              <td class="text-sm font-medium">{g.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Rate-limiting placement -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">Rate limiting: where to put it</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      The algorithm (token bucket, sliding window, etc.) is a separate decision —
      placement is where interviews probe design sense. In practice you layer:
      coarse at the edge, finer as you move inward.
    </p>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Where</th>
            <th>Good at</th>
            <th>Weakness</th>
          </tr>
        </thead>
        <tbody>
          {rateLimitPlacement.map((p) => (
            <tr>
              <td class="font-medium">{p.where}</td>
              <td class="text-sm">{p.good}</td>
              <td class="text-sm text-gray-600 dark:text-gray-400">{p.bad}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <NoteBox title="See the Patterns page" variant="tip">
      <p>
        The rate-limit <em>algorithm</em> trade-offs (token bucket vs leaky
        bucket vs sliding window) will live on the System Design page —
        algorithms are a separate concern from placement.
      </p>
    </NoteBox>
  </section>

  <!-- Sessions vs JWT -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">Sessions vs JWT</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      The question is not "is JWT cool" — it is "do I need stateless
      verification across services, or do I need instant revocation and tiny
      payloads?" Those point to different answers.
    </p>
    <div class="overflow-x-auto mb-4">
      <table class="data-table">
        <thead>
          <tr>
            <th>Aspect</th>
            <th>Session cookie</th>
            <th>JWT token</th>
          </tr>
        </thead>
        <tbody>
          {sessionVsToken.map((r) => (
            <tr>
              <td class="font-medium">{r.aspect}</td>
              <td class="text-sm">{r.sessionCookie}</td>
              <td class="text-sm">{r.jwtToken}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <NoteBox title="Rule of thumb" variant="tip">
      {sessionVsTokenRule}
    </NoteBox>
  </section>

  <!-- JWT pitfalls -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">JWT pitfalls</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Every one of these has a CVE behind it. Interviewers who have been burned
      test for them.
    </p>
    <SimpleTable data={jwtPitfalls} columns={jwtCols} />
  </section>

  <!-- Pagination -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">Pagination</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Four modes. Most teams pick offset because it is easy, then get surprised
      at page 10,000 or when concurrent inserts scramble results.
    </p>
    <SimpleTable data={paginationModes} columns={paginationCols} />
  </section>

  <!-- Webhooks -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">Webhooks — delivery practices</h2>
    <ul class="space-y-3">
      {webhookPractices.map((p) => (
        <li class="border-l-4 border-indigo-500 pl-4 py-2">
          <p class="font-semibold">{p.rule}</p>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{p.why}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Resilience -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-3">Resilience knobs</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Timeouts, retries, circuit breakers, bulkheads. Every synchronous RPC call
      in a high-traffic path needs most of these — missing any one is a
      well-documented outage pattern.
    </p>
    <SimpleTable data={resilienceKnobs} columns={resilienceCols} />
    <NoteBox title="The retry rule" variant="warning">
      {retryRule}
    </NoteBox>
  </section>
</DocsLayout>
